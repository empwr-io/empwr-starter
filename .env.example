# Copy to .env and fill in. .env is git-ignored and must stay that way.
# The two VITE_ values are PUBLIC by design: they ship inside the browser bundle.
# Your data is protected by row level security in the database, not by hiding these.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key in this file or anywhere the front end can read.
# It belongs in Supabase > Project Settings > Edge Functions > Secrets, nowhere else.
